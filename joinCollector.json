      "parameters": {
        "jsCode": "const today = new Date().toISOString().split('T')[0];\n\n\nconst currentCount = Number($json?.count || 0);\nconst newCount = currentCount + 1;\n\n\nconst email = $('Email Trigger (IMAP)').first().json;\nconst rawReturn = email.metadata['return-path'] || '';\nconst senderEmail = rawReturn.replace(/[<>]/g, '');\n\nreturn [\n  {\n    json: {\n      today,\n      count: newCount,\n      textPlain: email.textPlain,\n      from: email.from,\n      subject: email.subject,\n      senderEmail: senderEmail\n    }\n  }\n];\n"
